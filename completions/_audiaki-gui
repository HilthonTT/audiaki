#compdef audiaki-gui
# zsh completion for audiaki-gui(1)
# SPDX-License-Identifier: MIT

# The window has no --list of its own, so the device names come from the
# recorder next to it; see _audiaki, which defines this.
(( $+functions[_audiaki_devices] )) || _audiaki_devices() {
  local -a devices
  local -a run=(audiaki --list)

  (( $+commands[audiaki] )) || return 0
  (( $+commands[timeout] )) && run=(timeout 2 $run)

  devices=(${(f)"$($run 2>/dev/null | awk 'NR > 1 { print $1 }')"})
  devices=(default $devices)

  _describe -t devices 'capture device' devices
}

_audiaki_gui() {
  local -a args

  args=(
    '(-D --device)'{-D,--device}'[capture device the window opens on]:device:_audiaki_devices'
    '(-b --backend)'{-b,--backend}'[audio system to talk to]:backend:(auto pipewire alsa jack coreaudio)'
    '(-r --rate)'{-r,--rate}'[sample rate in Hz]:rate:(44100 48000 88200 96000 192000)'
    '(-c --channels)'{-c,--channels}'[channel count]:channels:(1 2 4 6 8)'
    '(-o --take)'{-o,--take}'[take name prefix]:prefix:_files'
    '--dir[folder to keep takes in]:folder:_files -/'
    '--no-dialog[do not ask where a take should be kept when it stops]'
    '(-s --style)'{-s,--style}'[visualiser style to start on]:style:(bars mirror radial scope waterfall tuner)'
    '--preroll[keep SECS of audio while idle, so takes start earlier]:seconds:'
    '--no-overdub[do not play the project while recording over it]'
    '--latency[round-trip latency to place an overdub by]:milliseconds:'
    '--gain[gain added to the recording itself, 0.0 to 16.0]:gain:'
    '--tempo[tempo the ruler counts bars on]:bpm:(60 80 90 100 110 120 140 160 180)'
    '--click[that tempo, with the metronome already on]:bpm:(60 80 90 100 110 120 140 160 180)'
    '--click-beats[beats to a bar, accenting the first]:beats:(1 2 3 4 5 6 7 8 12)'
    '--click-gain[how loud the click is, 0.0 to 2.0]:gain:'
    '--grid[come up with the bar grid drawn and snapped to]'
    '--loop[come up looping what Play is given]'
    '(-V --video)'{-V,--video}'[also render an MP4 of each take]'
    '--video-silent[render that MP4 without the take'"'"'s audio]'
    '--video-size[video size]:size:(480p 720p 1080p 1440p 2160p)'
    '--video-fps[video frame rate]:fps:'
    '(-M --monitor)'{-M,--monitor}'[start with playback monitoring on]'
    '(-v --verbose)'{-v,--verbose}'[log device negotiation to the terminal]'
    '(- *)'{-h,--help}'[show usage and exit]'
  )

  _arguments -s -S $args
}

_audiaki_gui "$@"
